structure          LIPID.psf
coordinates        LIPID.pdb
paraTypeCharmm     on
parameters         TOPPAR/par_all36_lipid.prm
exclude            scaled1-4
1-4scaling         1.0
cutoff             999.0
switching          off
pairlistdist       1000.0
temperature        500
langevin           on
langevinTemp       500
langevinDamping    5
timestep           1.0
rigidBonds         none
outputName         LIPID_chains
dcdfreq            2000
outputEnergies     100000
seed               1
colvars            on
colvarsConfig      LIPID_chains.colvars
minimize           2000
reinitvels         500
run                2000000
